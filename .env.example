# Copy this file to ".env" in the project root. Both the Next.js app, the seed script and the
# Python AI service read it. Never commit a real .env file or put real secrets in this example.

# ---------------------------------------------------------------- Next.js app
# REQUIRED in production, optional in demo mode (a clearly-labelled dev-only secret is used if empty).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# OPTIONAL. Leave empty to run in DEMO MODE (data stored in data/demo-db.json, no database needed).
# Set to your MongoDB Atlas connection string to use MongoDB.
MONGODB_URI=

# OPTIONAL. Where the Python AI service runs. If it is unreachable the app falls back to a
# clearly-labelled local keyword/TF-IDF engine and template drafts.
AI_SERVICE_URL=http://localhost:8000
# OPTIONAL. Shared secret sent as the X-AI-Token header. If set here it MUST also be set for the Python service (same file).
AI_SERVICE_TOKEN=
# OPTIONAL. Milliseconds to wait for the AI service (first request may download/load the model).
AI_TIMEOUT_MS=120000

# OPTIONAL. Password given to every seeded DEMO account (default: Demo@12345).
DEMO_PASSWORD=

# ---------------------------------------------------------------- Email, support, proxy (all OPTIONAL)
# Without SMTP_HOST, every email is stored in the admin "Support & feedback > Email outbox" as "stored, not sent". Needs the optional "nodemailer" package.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public base URL used inside emails (password reset and notification links).
APP_BASE_URL=http://localhost:3000
# Shown on the contact page and footer when set. Nothing is invented if empty.
SUPPORT_EMAIL=
# Set to 1 ONLY when running behind a reverse proxy that sets X-Forwarded-For (otherwise the header is ignored for rate limiting).
TRUST_PROXY=

# ---------------------------------------------------------------- Python AI service
# OPTIONAL. Embedding model (default is the required all-MiniLM-L6-v2).
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# OPTIONAL. Comma-separated origins allowed by CORS (default http://localhost:3000).
CORS_ORIGINS=http://localhost:3000
# OPTIONAL. Languages for OCR (Tesseract language codes, e.g. eng or eng+hin; needs the matching Tesseract language data installed).
OCR_LANGS=eng
# OPTIONAL. Local Hindi->English model (needs `pip install transformers sentencepiece`; otherwise the LLM is used, otherwise translation reports unavailable).
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-hi-en
# OPTIONAL. 1 = load the model in the background at startup (default), 0 = load on first request.
PRELOAD_MODEL=1

# OPTIONAL LLM for drafting. Without these three, drafts are produced by a clearly-labelled TEMPLATE (no LLM).
# LLM_PROVIDER: openai | openai_compatible | anthropic | gemini
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Only for openai_compatible (e.g. a local Ollama or other OpenAI-style endpoint), e.g. http://localhost:11434/v1
LLM_BASE_URL=
